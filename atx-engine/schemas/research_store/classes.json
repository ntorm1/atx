    {"id": "run-receipt", "label": "R1", "globs": ["**/receipt.json"], "schemas": ["atx.bounded-research-run/v1"], "format": "json", "ingest": "run", "render": {"mode": "typed", "rule": "py-indent2"}, "writer": "scripts/run_bounded_research.py", "pinned_by": "fields copied into stage receipts and wave-result timings", "stage": 1},
