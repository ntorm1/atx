      "ddl": [
        "CREATE TABLE artifact(path_key TEXT NOT NULL, path TEXT NOT NULL CHECK(instr(path, '\\') = 0 AND substr(path, 1, 1) <> '/' AND ('/' || path || '/') NOT GLOB '*/../*'), sha256 TEXT NOT NULL CHECK(length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'), bytes INTEGER, class TEXT NOT NULL, json_schema TEXT, sha_source TEXT NOT NULL CHECK(sha_source IN ('verified', 'declared')), declared_by TEXT CHECK(instr(declared_by, '\\') = 0 AND substr(declared_by, 1, 1) <> '/' AND ('/' || declared_by || '/') NOT GLOB '*/../*'), eol TEXT CHECK(eol IN ('lf', 'crlf', 'mixed', 'none')), producer_key TEXT CHECK(length(producer_key) = 64 AND producer_key NOT GLOB '*[^0-9a-f]*'), PRIMARY KEY(path_key)) STRICT, WITHOUT ROWID;",
        "CREATE INDEX ix_artifact_sha256 ON artifact(sha256);",
        "CREATE INDEX ix_artifact_class ON artifact(class);"
