{
  "name": "atx-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "gateway": "node gateway/main.mjs",
    "build": "tsc -b && vite build",
    "start": "node gateway/main.mjs",
    "test": "node --test gateway/*.test.mjs",
    "check": "tsc -b",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src gateway e2e playwright.config.ts vite.config.ts tsconfig.json package.json index.html README.md"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "dockview-react": "^4.13.1",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
