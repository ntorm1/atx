{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["oracle_lane_broker"],
  "permissions": {
    "allow": [
      "mcp__oracle_lane_broker__*",
      "Bash(powershell scripts/atx-build.ps1*)",
      "Bash(powershell scripts\\atx-build.ps1*)",
      "Bash(powershell scripts/lease-worktree.ps1*)",
      "Bash(powershell scripts\\lease-worktree.ps1*)",
      "PowerShell(powershell scripts\\atx-build.ps1*)",
      "PowerShell(scripts\\atx-build.ps1*)",
      "PowerShell(powershell scripts\\lease-worktree.ps1*)",
      "PowerShell(scripts\\lease-worktree.ps1*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(ctest*)"
