# Build directories
build/
build-rel/
build-ninja/
build-vs/
build-bench/
# Catch-all so a new preset's binaryDir (build-rel-avx2, build-hygiene, ...) is
# never swept into a commit by `git add -A`.
build-*/
out/
cmake-build-*/

# Per-worktree FetchContent deps (-DFETCHCONTENT_BASE_DIR=<wt>/deps/<preset>),
# the parallel-worktree isolation convention. Reproducible from configure.
/deps/

# Git worktrees (isolated workspaces)
.worktrees/
/.claire/

# Downloaded market data (DBN/parquet dumps from examples) — root-level only,
# so it never shadows source dirs like atx-engine/{include/atx/engine,src}/data/.
/data/

# Test-cached fitted-surface artifacts (dropped at repo root when running the
# test exe from there) — see atx-vol/tests/support/cached_artifacts.cpp.
/artifact-cache/

# clangd / tooling
.cache/
compile_commands.json
CMakeUserPresets.json

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
/build-counters/

# Secrets / local env (API keys, credentials)
.env
.env.*
!.env.example

# IDE
.vs/
.idea/
*.user

# VSCode: ignore everything except the shared project config below.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Compiled
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Generated benchmark / TSDB segment artifacts (e.g. atx_panel_bench.atxseg, 100s of MB)
*.atxseg

# Crash dumps
*.stackdump

# Scratch / experiment dirs (notebooks, throwaway scripts) — not versioned
scratch/
/work/
/scratch_wc_out.txt

# Subagent-driven-dev scratch (ledger, briefs, reports) — not versioned
.superpowers/


*.duckdb
*.duckdb*.bak
*.duckdb.wal*
*.duckdb_tmp/
.*.duckdb_tmp/

# Python warehouse (atx-impl/db) — code is tracked; data artifacts are not
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
# Parquet lakehouse exports are reproducible from the DuckDB warehouse
atx-impl/db/lake/
*.csv

# Vendor option-chain data (Databento OPRA) is NOT committed — licensing +
# repo policy ("commits no vendor option-chain data"). Real-data tests
# skip-if-absent; regenerate fixtures per the committed README/manifest.
atx-vol/tests/data/**/*.parquet
atx-vol/tests/data/**/*.dbn.zst
# Generated report artifacts (figures/html) — reproducible from the tool + script.
atx-vol/python/report_out_real/
.replay-xb/

# FetchContent isolated dependency trees (per-worktree, never committed).
# Set via -DFETCHCONTENT_BASE_DIR to keep parallel worktrees from sharing a
# build object tree and racing on _ITERATOR_DEBUG_LEVEL.
deps/
build-rel-avx2/
