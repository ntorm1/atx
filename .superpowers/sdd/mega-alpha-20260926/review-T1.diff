+    constexpr char digits[]="0123456789abcdef"; std::string tag(16,'0');
+    for (usize i=0;i<tag.size();++i) tag[i]=digits[(nonce>>(4*i))&15U];
+    path=final.parent_path()/("."+final.filename().string()+"."+tag+".partial");
