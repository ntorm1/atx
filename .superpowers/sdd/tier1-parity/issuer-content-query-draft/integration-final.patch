+                metric_code VARCHAR, metric_window VARCHAR, period_end DATE, value DOUBLE,
+                value_status VARCHAR, inputs_hash VARCHAR, as_of_date DATE,
+                available_at TIMESTAMP, source_loaded_at TIMESTAMP, run_id VARCHAR
+            )
