+    assert result.metadata["issuer_owner_ciks"][OWNER_COLLIDING] == (CIK_A, CIK_B)
+    assert result.metadata["excluded_derived_owner_ids"] == [OWNER_COLLIDING]
+    assert result.metadata["derived_issuer_owner_ids"] == [OWNER_SAFE]
+    assert result.data == [
