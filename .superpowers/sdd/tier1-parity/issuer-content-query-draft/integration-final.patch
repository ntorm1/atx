+                ("SEC-MARKET-A", "TICKER", "AAA", dt.date(2026, 9, 20), None, dt.date(2026, 9, 20), dt.datetime(2026, 9, 20, 9), "directory", dt.datetime(2026, 9, 20, 9)),
